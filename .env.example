# WorkflowMVP — secrets for **tools only** (copy to `.env` or paste in Settings).
# Server/bind/rlimits/uploads are configured elsewhere—not here.


# -----------------------------------------------------------------------------
# Google Gemini (`GEMINI_*`)
#
# Used by: LLM codegen, optional AI-assisted parsing, `generate_text` (and any
# codegen that inlines Gemini calls), and video→workflow framing.
#
# KEY: https://aistudio.google.com/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
# Optional override. If blank/unset, WorkflowMVP uses gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash


# -----------------------------------------------------------------------------
# SMTP (`EMAIL_*`) — send_email tool
#
# Omit or leave blank unless workflows call `send_email`. Gmail typical: enable
# 2FA, then create an app password used as EMAIL_PASSWORD.
# -----------------------------------------------------------------------------
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
SMTP_SERVER=
SMTP_PORT=
