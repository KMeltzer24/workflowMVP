# Copy to `.env` or paste values in the UI Settings modal.
# Blank values mean "unset / use code defaults".


# -----------------------------------------------------------------------------
# Google Gemini
# Used by codegen, optional parse cleanup, generate_text, and video framing.
# Key: https://aistudio.google.com/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
# Optional. Blank/unset → gemini-3.5-flash-lite (cheap default).
# For stronger codegen, set gemini-3.8-flash.
GEMINI_MODEL=gemini-3.5-flash-lite


# -----------------------------------------------------------------------------
# SMTP — send_email tool (optional)
# Gmail: enable 2FA, then an app password as EMAIL_PASSWORD.
# -----------------------------------------------------------------------------
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
SMTP_SERVER=
SMTP_PORT=


# -----------------------------------------------------------------------------
# Server bind and uploads (optional; defaults shown in comments)
# -----------------------------------------------------------------------------
# HOST=127.0.0.1
# PORT=5050
# WORKFLOW_MAX_UPLOAD_MB=100


# -----------------------------------------------------------------------------
# Run safety (optional)
# -----------------------------------------------------------------------------
# WORKFLOW_SAFETY_PROFILE=safe
# WORKFLOW_RLIMIT_CPU=120
# WORKFLOW_RLIMIT_AS_MB=1024
# WORKFLOW_RLIMIT_FSIZE_MB=100
# WORKFLOW_DISABLE_RLIMIT=0
# WORKFLOW_ENABLE_BLOCKING_RUN_ENDPOINT=0
# WORKFLOW_HTTP_CONNECT_TIMEOUT=8
